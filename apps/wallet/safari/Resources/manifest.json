{
  "manifest_version": 3,
  "name": "Orien Wallet",
  "description": "Your Orien Wallet in Safari: your balance and address, one click away.",
  "version": "1.0",
  "icons": { "32": "icon-32.png", "64": "icon-64.png", "128": "icon-128.png", "256": "icon-256.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icon-32.png", "64": "icon-64.png" }
  },
  "permissions": ["nativeMessaging"]
}
