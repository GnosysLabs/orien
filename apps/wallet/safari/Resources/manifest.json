{
  "manifest_version": 3,
  "name": "Orien Wallet",
  "description": "Your Orien Wallet in Safari: your balance, sending with Touch ID, and signing in to websites with your wallet.",
  "version": "1.0",
  "icons": {
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "19": "toolbar-19.png",
      "32": "toolbar-32.png",
      "38": "toolbar-38.png",
      "48": "toolbar-48.png",
      "64": "toolbar-64.png"
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://orien.network/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "provider.js"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
