{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orien Wallet",
  "version": "1.8.12",
  "identifier": "network.orien.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Orien Wallet",
        "visible": false,
        "backgroundThrottling": "disabled",
        "width": 560,
        "height": 620,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        },
        "minWidth": 520,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://orien.network",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://orien.network http://localhost:7200"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "The Orien wallet",
    "copyright": "Orien",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "developmentTeam": "4PDUNTF69S",
      "minimumSystemVersion": "16.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNTE1RTgyNDBEMzk1MzAKUldRd2xkTkFnbDVSd0QyVWk2cHJBemZyOTNDZ0tpUFdQaVRESS8vVWhqOVBDcklNb1VCNnBhc2YK",
      "endpoints": [
        "https://orien.network/wallet/latest.json"
      ]
    }
  }
}
