{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orien",
  "version": "1.0.0",
  "identifier": "network.orien.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Orien",
        "width": 460,
        "height": 580,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        },
        "minWidth": 400,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "The Orien wallet",
    "copyright": "Orien",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNTE1RTgyNDBEMzk1MzAKUldRd2xkTkFnbDVSd0QyVWk2cHJBemZyOTNDZ0tpUFdQaVRESS8vVWhqOVBDcklNb1VCNnBhc2YK",
      "endpoints": [
        "https://orien.network/wallet/latest.json"
      ]
    }
  }
}
