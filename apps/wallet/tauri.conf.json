{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orien",
  "version": "0.1.0",
  "identifier": "network.orien.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Orien",
        "width": 520,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
