# /etc/systemd/system/orien-market.service
# The Orien marketplace and swap board's server, behind nginx at
# orien.network/api/market/. It keeps its database and pictures in
# /var/lib/orien-market and reads its keys from /etc/orien-market.
#
#   systemctl enable --now orien-market
#
# The founder's dashboard listens on 127.0.0.1:7201, put on the tailnet only by
#   tailscale serve --bg --https=8448 http://127.0.0.1:7201
# and opened at https://cyphers-vps.yakalo-lizard.ts.net:8448/admin/
#
# Looking after it:
#   sudo -u orien-market orien-market --db /var/lib/orien-market/market.db reports

[Unit]
Description=Orien marketplace
After=network-online.target
Wants=network-online.target

[Service]
# Behind the validator on a shared server: a small share of the processor
# when it is busy, a memory ceiling, and stopped first if memory runs out.
CPUWeight=50
IOWeight=50
MemoryMax=2G
OOMScoreAdjust=500
User=orien-market
Group=orien-market
ExecStart=/usr/local/bin/orien-market \
    --db /var/lib/orien-market/market.db \
    --listen 127.0.0.1:7200 \
    --origin https://orien.network \
    --genesis /etc/orien-market/genesis.json \
    --address 74fa1ab82c45ebeed539b03146243ddfc6f0ccb5163f45ea87d21692ba774b7a \
    --resend-key /etc/orien-market/resend.key \
    --openrouter-key /etc/orien-market/openrouter.key \
    --helius-key /etc/orien-market/helius.key \
    --apns-key /etc/orien-market/apns.p8 \
    --apns-key-id YP4WHL3F3R \
    --min-swap-version 2 \
    --review-email appreview@orien.network \
    --review-code-file /etc/orien-market/review.code \
    --admin-listen 127.0.0.1:7201 \
    --admin-site /var/www/orien.network/current \
    --order-program 2HnMh1nAs5cShirEhk726KjBiQr4sxxMNv2qapjdYKN9 \
    --solana-relayer-key /etc/orien-market/solana-relayer.json \
    --sign-in-open
Restart=always
RestartSec=5

# It needs nothing but its own folder, its keys and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/orien-market
UMask=0077

[Install]
WantedBy=multi-user.target
