# /etc/systemd/system/orien-validator@.service
# One launch validator of the Orien network. Instance N (1 to 4) keeps its key
# and data in /var/lib/orien/vN and listens on port 710N.
#
#   systemctl enable --now orien-validator@1
#
# Each validator keeps itself on the newest release signed with the Orien
# release key: it installs it into /var/lib/orien/bin, which it may write,
# and restarts on it at a calm moment, one validator at a time. The network
# keeps running while any three of the four are up.

[Unit]
Description=Orien validator %i
After=network-online.target
Wants=network-online.target

[Service]
User=orien
Group=orien
ExecStart=/var/lib/orien/bin/orien node -g /var/lib/orien/genesis.json -k /var/lib/orien/v%i/validator.key -d /var/lib/orien/v%i/data --listen 0.0.0.0:710%i
Restart=always
RestartSec=5
# Up to 20,000 connections at once, each a thread and two open files.
LimitNOFILE=65536
TasksMax=24000

# It needs nothing but its own folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/orien
UMask=0077

[Install]
WantedBy=multi-user.target
